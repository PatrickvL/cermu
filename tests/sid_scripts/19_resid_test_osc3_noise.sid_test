# resid-test: test09 — OSC3 noise waveform
# Source: https://github.com/libsidplayfp/resid-test/blob/master/tests/test09
# Sets max frequency, resets with test bit, then enables noise.
# Checks OSC3 register output.

reset
check, 0x1b

# Voice 3 freq = 0xFFFF
write, 0x0f, 0xff
run, 3
write, 0x0e, 0xff
run, 3

# Test bit ON (resets accumulator & noise LFSR)
write, 0x12, 0x08
run, 3

# Noise ON (test bit OFF — LFSR starts shifting)
write, 0x12, 0x80
run, 1000

end
