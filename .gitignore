# Local configuration files
.vscode/settings.json

# Build directories
build/
tests/build/
_deps/
vcpkg_installed/

# CMake generated files (should never be committed)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*/Makefile
**/**/Makefile
CTestTestfile.cmake
**/**/CTestTestfile.cmake
compile_commands.json

# Visual Studio files
.vs/
*.sln
*.vcxproj
*.vcxproj.user
*.vcxproj.filters

# Executables
cermu
*.exe

# Object files
*.o
*.obj
*.lib

# Debug files
*.pdb
*.ilk
*.exp

# Build artifacts
*.a
*.recipe
*.lastbuildstate
*.tlog

# Runtime files
imgui.ini

# Data files (ROMs, cartridges, disk images) - keep README files
data/**/*.7z
data/**/*.a26
data/**/*.adf
data/**/*.bin
data/**/*.c64
data/**/*.cmd
data/**/*.cpr
data/**/*.crt
data/**/*.d64
data/**/*.d71
data/**/*.d81
data/**/*.dsk
data/**/*.fdi
data/**/*.gz
data/**/*.img
data/**/*.jpg
data/**/*.m3u
data/**/*.nes
data/**/*.nsf
data/**/*.p00
data/**/*.pdf
data/**/*.png
data/**/*.prg
data/**/*.rar
data/**/*.rom
data/**/*.ROM
data/**/*.s
data/**/*.sav
data/**/*.scl
data/**/*.sid
data/**/*.sna
data/**/*.sp
data/**/*.spg
data/**/*.szx
data/**/*.t64
data/**/*.tap
data/**/*.trd
data/**/*.txt
data/**/*.tzx
data/**/*.z80
data/**/*.zip
!data/**/README.md

# DDR computer ROMs — manufacturers dissolved after German reunification;
# no active copyright claimant. Included for preservation.
!data/kc85/roms/*.rom
!data/z1013/roms/*.rom
!data/z9001/roms/*.rom
!data/lc80/roms/*.rom

# MSX — C-BIOS (BSD 2-clause license), free MSX BIOS replacement.
!data/msx/roms/*.rom

# Atari ST — EmuTOS (GPL), free TOS replacement.
!data/atari_st/roms/*.img

# External dependencies - ignore by default, unignore committed items
# Submodules (ImGuiFileDialog, tomlplusplus, toonplusplus, LJON) are
# handled by .gitmodules and unaffected by this rule.
external/**

# Unignore documentation
!external/**/README.md
!external/**/*_SETUP*.md
!external/**/*_RESULTS*.md

# Unignore vendored single-file headers
!external/stb_image.h
!external/stb_image_write.h
!external/resid/
!external/resid/siddefs.h

# Downloaded test suites (contents ignored, READMEs kept above)
# external/6502-tests/  external/65c02-tests/  external/lorenz-tests/

# Other ignored directories
tests/processor_tests/

# Test runner executables and build artifacts
tests/build/
tests/fam65xx_klaus_test_runner
tests/fam65xx_lorenz_test_harness
tests/fam65xx_processor_tests_runner
.cache/

# Hide mcp-memory-service
.vscode/mcp.json
.memory/

# Hide graphify output
graphify-out/graph.json
src/graphify-out/