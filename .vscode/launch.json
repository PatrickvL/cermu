{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug cermu (Console)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/cermu_console",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake: build",
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "engineLogging": false
            }
        },
        {
            "name": "Debug cermu (GUI)",
            "type": "cppdbg",
