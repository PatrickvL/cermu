{
  "version": 4,
  "configurations": [
    {
      "name": "Linux",
      "compilerPath": "/usr/bin/g++",
      "intelliSenseMode": "linux-gcc-x64",
      "cStandard": "c17",
      "cppStandard": "c++20",
      "includePath": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/src/core",
        "${workspaceFolder}/src/chip/cpu/fam65xx",
        "${workspaceFolder}/src/chip/io",
        "${workspaceFolder}/src/chip/logic",
        "${workspaceFolder}/src/chip/memory",
        "${workspaceFolder}/src/chip/sound",
        "${workspaceFolder}/src/chip/video",
        "${workspaceFolder}/src/systems/c64",
        "${workspaceFolder}/src/main",
        "${workspaceFolder}/src/gui",
        "${workspaceFolder}/external/imgui",
        "${workspaceFolder}/external/imgui/backends",
        "/usr/include",
        "/usr/include/SDL2",
        "/usr/local/include",
        "/usr/local/include/SDL2"
      ],
      "defines": [
        "SDL_MAIN_HANDLED",
        "CIMGUI_DEFINE_ENUMS_AND_STRUCTS"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}",
          "/usr/include",
          "/usr/include/SDL2",
          "/usr/local/include",
          "/usr/local/include/SDL2"
        ],
        "limitSymbolsToIncludedHeaders": true
      },
      "compileCommands": "${workspaceFolder}/build/compile_commands.json",
      "configurationProvider": "ms-vscode.cmake-tools"
    }
  ]
}